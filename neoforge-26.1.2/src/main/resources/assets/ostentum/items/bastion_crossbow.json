{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:charge_type",
    "cases": [
      {
        "when": "arrow",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "index": 0,
          "cases": [
            {
              "when": "fire_charge",
              "model": {
                "type": "minecraft:model",
                "model": "ostentum:item/bastion_crossbow_fire_charge"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "ostentum:item/bastion_crossbow_arrow"
          }
        }
      },
      {
        "when": "rocket",
        "model": {
          "type": "minecraft:model",
          "model": "ostentum:item/bastion_crossbow_firework"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": {
        "type": "minecraft:model",
        "model": "ostentum:item/bastion_crossbow"
      },
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:crossbow/pull",
        "entries": [
          {
            "threshold": 0.58,
            "model": {
              "type": "minecraft:model",
              "model": "ostentum:item/bastion_crossbow_pulling_1"
            }
          },
          {
            "threshold": 1.0,
            "model": {
              "type": "minecraft:model",
              "model": "ostentum:item/bastion_crossbow_pulling_2"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "ostentum:item/bastion_crossbow_pulling_0"
        }
      }
    }
  }
}
