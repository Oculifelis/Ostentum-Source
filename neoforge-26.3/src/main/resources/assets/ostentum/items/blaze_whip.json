{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed",
          "on_shelf"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "ostentum:item/blaze_whip"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "fundamentum:whip_flat_handles",
      "on_true": {
        "type": "minecraft:model",
        "model": "ostentum:item/blaze_whip_grip"
      },
      "on_false": {
        "type": "minecraft:composite",
        "models": [
          {
            "type": "minecraft:model",
            "model": "ostentum:item/blaze_whip_held"
          },
          {
            "type": "minecraft:special",
            "base": "ostentum:item/blaze_whip_held",
            "model": {
              "type": "ostentum:blaze_rods"
            }
          }
        ]
      }
    }
  }
}
